# database
DATABASE_URL=sqlite:///./event_conference_platform.db

# jwt
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# celery - separate redis db numbers from the cache, so celery's own
# bookkeeping never mixes with cached data
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=mathivarmaganesan@gmail.com
SMTP_PASSWORD=pigp fuft gdqf jkaa
SMTP_FROM_EMAIL=mathivarmaganesan@gmail.com

# default admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_PHONE=9999999999

# rate limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# refund policy - the exact tiers the task leaves unspecified, our own
# reasonable defaults, genuinely configurable here without touching code
REFUND_FULL_REFUND_DAYS_BEFORE=7
REFUND_PARTIAL_REFUND_PERCENTAGE=0.50